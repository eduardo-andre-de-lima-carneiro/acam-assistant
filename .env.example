# Copy to .env and adjust. Never commit .env.

# --- Analysis engine -----------------------------------------------------------
# Enables Claude analysis; without it the offline heuristic engine is used.
ANTHROPIC_API_KEY=
# ACAM_MODEL=claude-opus-5-5

# --- Accounts ---------------------------------------------------------------------
# Create this administrator on first start (skipped if it already exists).
# Leave empty to create the first account from the web page instead.
ACAM_ADMIN_USER=
ACAM_ADMIN_NAME=
# Prefer a secret file (see docker-compose.yml); the plain variable is a fallback.
# ACAM_ADMIN_PASSWORD_FILE=/run/secrets/admin_password
ACAM_ADMIN_PASSWORD=
# Let anyone register (true/false). The first account can always be created.
ACAM_ALLOW_SIGNUP=false

# --- HTTP ----------------------------------------------------------------------------
# true when users reach the app over HTTPS (always with the "tls" profile).
ACAM_SECURE_COOKIES=false
# Host port for the app (bound to 127.0.0.1).
ACAM_PORT=8000
# Public domain for the "tls" profile (Caddy + Let's Encrypt).
ACAM_DOMAIN=
# Proxy addresses trusted for X-Forwarded-* headers ("*" inside the compose network).
FORWARDED_ALLOW_IPS=*

# --- Server tuning ----------------------------------------------------------------
# Web processes and threads per process.
ACAM_WORKERS=2
ACAM_THREADS=4
# Concurrent analyses per worker container (bounded by your Anthropic rate limit).
ACAM_WORKER_THREADS=2
ACAM_TIMEOUT=120
ACAM_LOG_LEVEL=info
